{
  "name": "khatab-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3040",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3040",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/generate-theme.cjs",
    "predev": "node scripts/generate-theme.cjs",
    "test:platform": "playwright test --project=platform",
    "test:fixtures:build": "node scripts/prepare-reuse-fixture.cjs",
    "test:architecture": "node scripts/architecture-boundaries.cjs",
    "test:crossbrowser": "playwright test --config playwright.crossbrowser.config.ts",
    "typecheck": "tsc --noEmit",
    "backend:seed:generate": "tsx scripts/backend/generate-seed.ts",
    "backend:test": "node tests/backend/integration.cjs",
    "backend:migrate:hosted": "node scripts/backend/migrate-hosted.cjs"
  },
  "dependencies": {
    "@khatab/design": "file:packages/design-system",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "libphonenumber-js": "1.13.15",
    "next": "^16.3.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.8",
    "pg": "8.16.3",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.2",
    "unique-names-generator": "4.7.1"
  }
}
