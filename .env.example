NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
APP_ORIGIN=http://localhost:3040
# Server-only: required for administrator user management. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-project-secret-key

# Cloudinary: server-only; never use NEXT_PUBLIC_ for these variables.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Fawaterak OAuth v3: server-only. Hosted checkout does not require PROVIDER_KEY.
FAWATERAK_TOKEN_URL=https://app.fawaterk.com/oauth/token
FAWATERAK_CLIENT_ID=replace-with-fawaterak-client-id
FAWATERAK_CLIENT_SECRET=replace-with-fawaterak-client-secret
HASH_API_KEY=replace-with-fawaterak-merchant-hash-key
